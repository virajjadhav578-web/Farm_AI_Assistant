# ==============================================================================
# FARM AI ASSISTANT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
#
# NOTE: All keys are optional for demo evaluation! When keys are omitted, the
# platform automatically operates in high-fidelity 'Demo Mode' with realistic
# regional agricultural baselines and client-side persistence.
# ==============================================================================

# 1. Supabase PostgreSQL & Auth (Required for persistent multi-user database)
# Obtain from: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# 2. AI Agronomist & Disease Detection LLM API Key (Server-only)
# Obtain from: Google AI Studio (https://aistudio.google.com) or compatible LLM provider
AI_API_KEY=your-gemini-or-llm-api-key-here

# 3. Meteorological Provider (Open-Meteo is free & keyless by default)
# Configurable if using a dedicated enterprise proxy or custom endpoint
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# 4. Official Agricultural Market Data API (Optional)
# Obtain from: https://data.gov.in (Agmarknet Daily Mandi Arrivals dataset)
MARKET_DATA_API_KEY=your-datagov-api-key-here
